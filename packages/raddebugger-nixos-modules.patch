+// NixOS' dynamic loader is built without the optional SystemTap probes used by
+// the normal module notification path. Synchronize against the standard ELF
+// r_debug link map whenever the debuggee stops at a breakpoint instead.
+internal void
+lnx_dmn_sync_modules_from_rdebug(Arena *arena, DMN_EventList *events, LNX_DMN_Thread *thread)
+{
+  LNX_DMN_Process *process = thread->process;
+  if(process->ctx->rdebug_vaddr == 0)
+  {
+    return;
+  }
+
+  GNU_RDebugInfo64 rdebug = {0};
+  if(gnu_read_r_debug(lnx_dmn_machine_op_mem_read, &process->fd, process->ctx->rdebug_vaddr, process->ctx->arch, &rdebug) != MachineOpResult_Ok ||
+     rdebug.r_state != GNU_RT_Consistent)
+  {
+    return;
+  }
+
+  if(process->is_cow)
+  {
+    process->is_cow = 0;
+    process->ctx = lnx_dmn_process_ctx_clone(process, process->ctx);
+  }
+  LNX_DMN_ProcessCtx *ctx = process->ctx;
+  for(LNX_DMN_Module *module = ctx->first_module; module != 0; module = module->order_next)
+  {
+    module->is_live = 0;
+  }
+
+  B32 is_64bit = ctx->dl_class == ELF_Class_64;
+  for(U64 map_vaddr = rdebug.r_map; map_vaddr != 0;)
+  {
+    GNU_LinkMap64 map = {0};
+    if(gnu_read_link_map(lnx_dmn_machine_op_mem_read, &process->fd, map_vaddr, is_64bit, &map) != MachineOpResult_Ok)
+    {
+      break;
+    }
+    map_vaddr = map.next_vaddr;
+
+    LNX_DMN_Module *module = 0;
+    U64 hash = u64_hash_from_str8(str8_struct(&map.addr_vaddr));
+    U64 slot_idx = hash%ctx->module_slots_count;
+    for(LNX_DMN_Module *m = ctx->module_slots[slot_idx].first; m != 0; m = m->hash_next)
+    {
+      if(m->base_vaddr == map.addr_vaddr)
+      {
+        module = m;
+        break;
+      }
+    }
+    if(module == 0)
+    {
+      module = lnx_dmn_module_alloc(ctx, process->fd, map.addr_vaddr, map.name_vaddr, 0, 0);
+      lnx_dmn_push_event_load_module(arena, events, thread, module);
+    }
+    module->is_live = 1;
+  }
+
+  for(LNX_DMN_Module *module = ctx->first_module, *next = 0; module != 0; module = next)
+  {
+    next = module->order_next;
+    if(!module->is_live)
+    {
+      lnx_dmn_push_event_unload_module(arena, events, process, module);
+      lnx_dmn_module_release(ctx, module);
+    }
+  }
+}
